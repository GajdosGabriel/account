#
# Vzor konfiguracie. Su tu len nazvy premennych a nekriticke predvolby -
# ziadne skutocne hesla, kluce ani tokeny. Tento subor je v gite, takze
# vsetko tajne patri vylucne do .env, ktory je v .gitignore.
#
# Novy projekt: cp .env.example .env && php artisan key:generate
#

APP_NAME=Account
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://account.zastavy-vlajky.sk

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK
APP_TIMEZONE=Europe/Bratislava

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=account
DB_USERNAME=root
DB_PASSWORD=

# Nechces riesit MySQL? Zakomentuj blok vyssie a odkomentuj tento riadok:
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Musi zodpovedat domene aplikacie. null = odvodi sa z APP_URL.
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=s3

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Account"

VITE_APP_NAME="${APP_NAME}"

# Prvy operator – aplikacia nema registraciu, ucet vyrobi:
#   php artisan db:seed --class=AdminUserSeeder
SEED_ADMIN_EMAIL=
# Bcrypt hash, nie citatelne heslo. Novy: php artisan tinker --execute="echo bcrypt('heslo');"
# Jednoduche uvodzovky su nutne, inak by sa $ v hashi bral ako premenna.
SEED_ADMIN_PASSWORD=

#
# --- Predplatne -----------------------------------------------------------
#
# Po zlyhanej platbe: grace dni plny pristup, potom read-only, potom zamknutie.
ACCOUNTS_GRACE_DAYS=14
ACCOUNTS_SUSPENDED_DAYS=30

#
# --- Overovanie firemnych udajov ------------------------------------------
#
ACCOUNTS_RPO_ENABLED=true
ACCOUNTS_RPO_BASE_URL=https://api.statistics.sk/rpo/v1
ACCOUNTS_VIES_ENABLED=true
ACCOUNTS_VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

#
# --- Stripe (nepovinne, bez klucov sa predplatne spravuje rucne) ----------
#
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

#
# --- Fakturacia: udaje dodavatela (tvoja firma) ---------------------------
#
# Toto sa tlaci do laveho stlpca faktury. Pri vystaveni sa udaje odfotia
# do dokladu, takze neskorsia zmena stare faktury neovplyvni.
#
INVOICE_SUPPLIER_NAME="Gabriel Gajdoš - REPREZENT"
INVOICE_SUPPLIER_STREET=
INVOICE_SUPPLIER_CITY=
INVOICE_SUPPLIER_ZIP=
INVOICE_SUPPLIER_COUNTRY=SK
INVOICE_SUPPLIER_ICO=14287315
INVOICE_SUPPLIER_DIC=1020747398
# Prazdne IC DPH => neplatitel, na fakture sa DPH netlaci
INVOICE_SUPPLIER_IC_DPH=SK1020747398
INVOICE_SUPPLIER_VAT_PAYER=true
INVOICE_SUPPLIER_REGISTRATION="Okresný úrad Bardejov, živnostenský register č. 701-4101"
INVOICE_SUPPLIER_EMAIL=gajdosgabo@gmail.com
INVOICE_SUPPLIER_PHONE=
INVOICE_SUPPLIER_WEB=
INVOICE_SUPPLIER_BANK=
INVOICE_SUPPLIER_IBAN=
INVOICE_SUPPLIER_SWIFT=
# Nepovinne: cesta k logu v public/, napr. images/logo.png
INVOICE_SUPPLIER_LOGO=
INVOICE_SUPPLIER_ISSUED_BY="Gabriel Gajdoš"

#
# --- Fakturacia: doklady --------------------------------------------------
#
INVOICE_VAT_RATE=23
INVOICE_DUE_DAYS=14
INVOICE_CONSTANT_SYMBOL=0308
INVOICE_FOOTER_NOTE=
INVOICE_DISK=s3

# QR platba: pay_by_square (SK banky) alebo epc (SEPA / DE, AT)
INVOICE_QR_ENABLED=true
INVOICE_QR_FORMAT=pay_by_square

# Automaticka fakturacia predplatneho (php artisan invoices:generate)
INVOICE_ISSUE_DAYS_BEFORE=7
INVOICE_AUTO_ISSUE=false
INVOICE_AUTO_SEND=false

# Upomienky po splatnosti (php artisan invoices:remind)
INVOICE_REMINDERS_ENABLED=true
INVOICE_REMINDERS_COPY=false

#
# --- Pripojene projekty -----------------------------------------------------
#
# Token musi byt zhodny s ACCOUNT_TOKEN v .env pripojeneho projektu.
# Webhookove tajomstvo musi byt zhodne s ACCOUNT_WEBHOOK_SECRET tam.
# Su to dve nezavisle hodnoty a nesmu sa zamienat:
#   *_SERVICE_TOKEN   projekt -> Account (kto sa pyta)
#   *_WEBHOOK_SECRET  Account -> projekt (kto oznamuje)
# Obe hodnoty vygenerujes napriklad takto:
#   php -r "echo 'acc_'.bin2hex(random_bytes(24)).PHP_EOL;"
#   php -r "echo 'whsec_'.bin2hex(random_bytes(24)).PHP_EOL;"
SAMOSPRAVA_URL=
SAMOSPRAVA_SERVICE_TOKEN=
SAMOSPRAVA_WEBHOOK_URL=
SAMOSPRAVA_WEBHOOK_SECRET=

ANONYMIZER_URL=http://anonymizer.local
ANONYMIZER_SERVICE_TOKEN=
ANONYMIZER_WEBHOOK_URL=http://anonymizer.local/api/webhooks/account
ANONYMIZER_WEBHOOK_SECRET=
SESSION_SECURE_COOKIE=false
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# S3 úložisko. Pre prechod na S3 vyplň kľúče nižšie a prepni FILESYSTEM_DISK=s3.
# AWS_URL = verejná doména na čítanie objektov (CloudFront alebo statická S3/website
# doména). Používa sa na generovanie verejných URL cez Storage::disk('s3')->url().
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
# AWS_ROOT oddeľuje prostredia v spoločnom buckete: na produkcii `prod`, lokálne `dev`.
# Bez neho si dev a produkcia prepisujú súbory (cesty sa v oboch databázach opakujú).
AWS_ROOT=prod
AWS_URL=
# AWS_ENDPOINT = len pre S3-kompatibilné úložisko mimo AWS (napr. MinIO); pre reálne AWS nechaj prázdne.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
