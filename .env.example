APP_NAME=Account
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK
APP_TIMEZONE=Europe/Bratislava

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=account
DB_USERNAME=root
DB_PASSWORD=

# Nechces riesit MySQL? Zakomentuj blok vyssie a odkomentuj tento riadok:
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Musi zodpovedat domene aplikacie. null = odvodi sa z APP_URL.
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="account@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Ucet vytvoreny cez php artisan db:seed
SEED_ADMIN_EMAIL=admin@account.local
SEED_ADMIN_PASSWORD=password

#
# --- Predplatne -----------------------------------------------------------
#
# Po zlyhanej platbe: grace dni plny pristup, potom read-only, potom zamknutie.
ACCOUNTS_GRACE_DAYS=14
ACCOUNTS_SUSPENDED_DAYS=30

#
# --- Overovanie firemnych udajov ------------------------------------------
#
ACCOUNTS_RPO_ENABLED=true
ACCOUNTS_RPO_BASE_URL=https://api.statistics.sk/rpo/v1
ACCOUNTS_VIES_ENABLED=true
ACCOUNTS_VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

#
# --- Stripe (nepovinne, bez klucov sa predplatne spravuje rucne) ----------
#
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

#
# --- Fakturacia: udaje dodavatela (tvoja firma) ---------------------------
#
# Toto sa tlaci do laveho stlpca faktury. Pri vystaveni sa udaje odfotia
# do dokladu, takze neskorsia zmena stare faktury neovplyvni.
#
INVOICE_SUPPLIER_NAME="Moja firma, s. r. o."
INVOICE_SUPPLIER_STREET="Hlavna 1"
INVOICE_SUPPLIER_CITY="Bratislava"
INVOICE_SUPPLIER_ZIP="81101"
INVOICE_SUPPLIER_COUNTRY=SK
INVOICE_SUPPLIER_ICO=12345678
INVOICE_SUPPLIER_DIC=2020123456
# Prazdne IC DPH => neplatitel, na fakture sa DPH netlaci
INVOICE_SUPPLIER_IC_DPH=SK2020123456
INVOICE_SUPPLIER_VAT_PAYER=true
INVOICE_SUPPLIER_REGISTRATION="Okresny sud Bratislava I, oddiel Sro, vlozka c. 12345/B"
INVOICE_SUPPLIER_EMAIL=faktury@mojafirma.sk
INVOICE_SUPPLIER_PHONE="+421 900 000 000"
INVOICE_SUPPLIER_WEB=https://mojafirma.sk
INVOICE_SUPPLIER_BANK="Tatra banka, a. s."
INVOICE_SUPPLIER_IBAN=SK3112000000198742637541
INVOICE_SUPPLIER_SWIFT=TATRSKBX
# Nepovinne: cesta k logu v public/, napr. images/logo.png
INVOICE_SUPPLIER_LOGO=
INVOICE_SUPPLIER_ISSUED_BY=

#
# --- Fakturacia: doklady --------------------------------------------------
#
INVOICE_VAT_RATE=23
INVOICE_DUE_DAYS=14
INVOICE_CONSTANT_SYMBOL=0308
INVOICE_FOOTER_NOTE=
INVOICE_DISK=local

# QR platba: pay_by_square (SK banky) alebo epc (SEPA / DE, AT)
INVOICE_QR_ENABLED=true
INVOICE_QR_FORMAT=pay_by_square

# Automaticka fakturacia predplatneho (php artisan invoices:generate)
INVOICE_ISSUE_DAYS_BEFORE=7
INVOICE_AUTO_ISSUE=false
INVOICE_AUTO_SEND=false

# Upomienky po splatnosti (php artisan invoices:remind)
INVOICE_REMINDERS_ENABLED=true
INVOICE_REMINDERS_COPY=false

#
# --- Pripojene projekty -----------------------------------------------------
#
# Token musi byt zhodny s ACCOUNT_TOKEN v .env pripojeneho projektu.
SAMOSPRAVA_URL=http://samosprava.local
SAMOSPRAVA_SERVICE_TOKEN=
